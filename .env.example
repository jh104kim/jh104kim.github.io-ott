# ==============================================================================
# Screen Intelligence Agent — Environment Variables (.env.example)
# [초간편 시작 가이드]
# 이 파일을 복사하여 `.env` 파일을 만들고,
# 아래 'GEMINI_API_KEY' 하나만 넣으면 로컬 빌드 및 개발 실행이 바로 가능합니다!
# ==============================================================================

# ==============================================================================
# ★ [필수] 1. Google Gemini API Key (유일한 필수 입력값)
# Google AI Studio (https://aistudio.google.com/)에서 무료 발급받은 키를 입력하세요.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 모델 설정 (기본값 유지 권장)
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_REASONING=gemini-2.5-pro

# ==============================================================================
# [자동 설정됨] 2. 개발용 로그인 바이패스 (Google OAuth 키 불필요!)
# AUTH_DEV_BYPASS=true 상태에서는 Google Cloud OAuth 설정 없이도
# 로컬 개발용 기본 관리자(Dev Admin)로 원클릭 자동 로그인됩니다.
# ==============================================================================
AUTH_DEV_BYPASS=true
DEV_USER_EMAIL=dev-admin@local.test
DEV_USER_NAME="Dev Administrator"
DEV_USER_GOOGLE_SUB=dev_admin_local_sub_001

# 실제 Google OAuth를 연동할 때만 아래 2개를 채우고 AUTH_DEV_BYPASS=false 로 변경하세요.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 내부 보안 비밀키 (개발용 기본값이 이미 설정되어 있어 수정 불필요)
INTERNAL_AUTH_SECRET=dev_internal_auth_secret_key_32bytes_min_12345
NEXTAUTH_SECRET=dev_nextauth_cookie_secret_key_32bytes_12345
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# [자동 설정됨] 3. 데이터베이스 (Docker Compose PostgreSQL 16 기본값)
# docker compose up -d 실행 시 아래 계정으로 자동 생성되므로 수정 불필요합니다.
# ==============================================================================
POSTGRES_USER=screen_intel
POSTGRES_PASSWORD=screen_intel_local_secret
POSTGRES_DB=screen_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://screen_intel:screen_intel_local_secret@localhost:5432/screen_intelligence

# ==============================================================================
# [자동 설정됨] 4. 외부 데이터 Mock 모드 (TMDB/YouTube/극장 키 불필요!)
# PROVIDER_MODE=mock 상태에서는 외부 유료/제휴 키 없이도
# 내장된 10여 개 검증 Fixture 데이터를 통해 100% 정상 작동합니다.
# ==============================================================================
PROVIDER_MODE=mock
TMDB_API_KEY=
YOUTUBE_API_KEY=
KOBIS_API_KEY=

# ==============================================================================
# [자동 설정됨] 5. 비용 원장(Usage Ledger) 및 서버 통신 기본값
# ==============================================================================
USER_DAILY_PAID_REQUEST_LIMIT=10
SERVICE_MONTHLY_GEMINI_BUDGET_USD=30.0
DEFAULT_RESERVATION_USD=0.01

FASTAPI_URL=http://localhost:8000
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
